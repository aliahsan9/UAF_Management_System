## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs
mono_crash.*

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Oo]ut/
[Ll]og/
[Ll]ogs/
.vs/
TestResults/
artifacts/
coverage*/
*.coverage
*.coveragexml
*.binlog

# IDE and tooling
_ReSharper*/
*.DotSettings.user
.ntvs_analysis.dat
node_modules/
__pycache__/
*.pyc
.localhistory/

# NuGet
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/

# Publishing credentials and certificates
*.pubxml
*.publishproj
PublishScripts/
*.pfx
*.publishsettings
*.key
*.pem
*.secrets.json
secrets.json
.env
.env.*
!.env.example

# Local databases and private uploaded files
*.mdf
*.ldf
*.ndf
**/App_Data/PrivateAdmissionDocuments/
**/private-admission-documents/

# Local logs and generated outputs
*.log
logs/
